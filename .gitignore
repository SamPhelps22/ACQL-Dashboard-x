# Bootstrapped environment and dependency stamp
.venv/
__pycache__/
*.py[cod]

# Build output
build/
dist/
*.spec.bak

# Runtime state
acql-settings.json
backups/

# Weekly spreadsheets dropped in by users; the samples at the repo root stay.
data/*.xls
data/*.xlsx
data/*.xlsm
!data/README.md

# OS noise
.DS_Store
Thumbs.db
~$*

# Written by the scheduled job (acql/headless.py) and the self-check as they run
data/headless.lock
data/selfcheck/
predictions/
data/site-preview/
