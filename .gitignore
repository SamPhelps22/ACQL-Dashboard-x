# Bootstrapped environment and dependency stamp
.venv/
__pycache__/
*.py[cod]

# Build output
build/
dist/
*.spec.bak

# Runtime state
acql-settings.json
backups/

# Weekly spreadsheets dropped in by users; the samples at the repo root stay.
data/*.xls
data/*.xlsx
data/*.xlsm
!data/README.md

# OS noise
.DS_Store
Thumbs.db
~$*

# Written by the scheduled job (acql/headless.py) and the self-check as they run
data/headless.lock
# The app's own database and log: this computer's, rewritten every few minutes,
# and no business of a public repository
data/acql.db
data/acql.db-*
data/acql-log.txt
# Written by the app as it runs (cards kept, email and odds settings): this computer's own too
data/acql-cards.json
data/acql-email.json
data/acql-odds.json
data/selfcheck/
predictions/
data/site-preview/
data/deadeye-email-preview.html
data/nflverse/
data/tracker/
# Recap pictures made for the pool: this computer's own too
data/recaps/
data/logos/

# Challenger raw downloads and aggregates (re-fetchable: python -m challenger fetch)
data/challenger/
