{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Deadeye training: run (the whole thing, and the report)",
            "type": "debugpy",
            "request": "launch",
            "module": "acql.training",
            "args": ["run"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Deadeye training: audit (what data there is)",
            "type": "debugpy",
            "request": "launch",
            "module": "acql.training",
            "args": ["audit"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Deadeye training: snapshot (freeze this week before the deadline)",
            "type": "debugpy",
            "request": "launch",
            "module": "acql.training",
            "args": ["snapshot"],
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Deadeye training: tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_training.py",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
