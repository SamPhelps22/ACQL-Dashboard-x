{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Deadeye training: run",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "acql.training", "run"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Deadeye training: audit",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "acql.training", "audit"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Deadeye training: snapshot",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "acql.training", "snapshot"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Deadeye training: check (no result can leak backwards)",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["-m", "acql.training", "check"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Deadeye training: tests",
            "type": "process",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["tests/test_training.py"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "group": "test",
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
