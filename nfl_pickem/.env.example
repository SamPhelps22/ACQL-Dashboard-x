# Copy to .env (never commit .env). Every key is optional: without them the
# app runs from free nflverse data and/or the synthetic demo dataset.

# The Odds API (https://the-odds-api.com) - live moneylines/spreads snapshots.
ODDS_API_KEY=your-odds-api-key-here
# Comma-separated bookmaker keys to keep (blank = all returned for region).
ODDS_API_BOOKMAKERS=
ODDS_API_REGIONS=us

# Override the database location (default: data/nflpickem.duckdb).
NFLPICKEM_DB_PATH=
# Set to 1 to run tests that download real nflverse data.
NFLPICKEM_NETWORK_TESTS=0
